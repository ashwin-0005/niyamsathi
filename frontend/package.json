{
  "name": "niyamsathi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:rules && npm run test:render",
    "test:rules": "esbuild --bundle --platform=node --format=cjs --loader:.json=json --loader:.css=empty --jsx=automatic --log-level=warning scripts/selftest.ts --outfile=.tmp/selftest.cjs && node .tmp/selftest.cjs",
    "test:render": "esbuild --bundle --platform=node --format=cjs --loader:.json=json --loader:.css=empty --jsx=automatic --log-level=warning scripts/rendertest.tsx --outfile=.tmp/rendertest.cjs && node .tmp/rendertest.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
