{
  "name": "niyamsathi-fullstack",
  "version": "1.0.0",
  "description": "NiyamSathi - Bhopal Building Rules Assistant with Visual Compliance Map",
  "private": true,
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:full": "concurrently \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "test": "npm run test -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "backend:start": "npm run start -w backend",
    "backend:dev": "npm run dev -w backend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
